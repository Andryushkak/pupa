<!DOCTYPE html>
<html>
<head>
  <title>Home</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
</head>
<body class="fade-in">
  <div class="navbar main-nav">
    <a href="/">Home</a>
    <% if (user) { %>
      <a href="/profile">Profile</a>
      <a href="/books/add">Add Book</a>
      <a href="/logout">Logout</a>
    <% } else { %>
      <a href="/login">Login</a>
      <a href="/register">Register</a>
    <% } %>
  </div>

  <div class="container">
    <h1 class="main-title">Книжкова галерея</h1>

    <form method="GET" action="/" class="search-form standalone-search">
      <div class="search-group">
        <label for="search" class="search-label">Пошук книги або автора:</label>
        <input
          type="text"
          id="search"
          name="q"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          placeholder="Введіть назву або автора..."
          class="search-input"
        />
      </div>
    </form>

    <button id="filter-toggle" class="btn-primary filter-toggle">Фільтр</button>

    <div class="search-container" id="search-container">
      <form method="GET" action="/" class="search-form">
        <input
          type="hidden"
          name="q"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
        >

        <div class="filter-group">
          <label class="filter-label">Жанри:</label>

          <div class="genre-tags">
            <label class="genre-tag">
              <input
                type="checkbox"
                id="all-genres"
                <%= selectedGenres.length === 0 ? 'checked' : '' %>
              >
              <span>Усі</span>
            </label>

            <% genres.forEach(g => { %>
              <label class="genre-tag">
                <input
                  type="checkbox"
                  name="genre"
                  value="<%= g %>"
                  <%= selectedGenres.includes(g) ? 'checked' : '' %>
                  onchange="this.form.submit()"
                >
                <span><%= g %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="filter-group">
          <label for="sort" class="filter-label">Сортувати:</label>
          <select id="sort" name="sort" onchange="this.form.submit()" class="filter-select">
            <option value="asc" <%= sortOrder === 'asc' ? 'selected' : '' %>>A→Z</option>
            <option value="desc" <%= sortOrder === 'desc' ? 'selected' : '' %>>Z→A</option>
          </select>
        </div>
      </form>
    </div>

    <div class="book-grid">
      <% if (books && books.length > 0) { %>
        <% books.forEach(book => { %>
          <div class="book-card">
            <a href="/books/<%= book._id %>">
              <% if (book.coverImage) { %>
                <img src="<%= book.coverImage %>" alt="Обкладинка" class="book-cover" />
              <% } else { %>
                <div class="book-placeholder">Без фото</div>
              <% } %>
              <h3><%= book.title %></h3>
            </a>
          </div>
        <% }) %>
      <% } else { %>
        <p>Немає книг для відображення.</p>
      <% } %>
    </div>
  </div>

  <script>
    const filterToggle = document.getElementById('filter-toggle');
    const searchContainer = document.getElementById('search-container');
    const genreInputs = document.querySelectorAll('input[name="genre"]');
    const sortSelect = document.getElementById('sort');
    const allGenresCheckbox = document.getElementById('all-genres');

    function openFilters() {
      searchContainer.style.display = 'block';
      searchContainer.style.opacity = '1';
      searchContainer.style.transform = 'translateY(0)';
    }

    function closeFilters() {
      searchContainer.style.opacity = '0';
      searchContainer.style.transform = 'translateY(-16px)';
      setTimeout(() => {
        searchContainer.style.display = 'none';
      }, 300);
    }

    filterToggle.addEventListener('click', function () {
      const isClosed =
        searchContainer.style.display === 'none' ||
        searchContainer.style.display === '';

      if (isClosed) {
        openFilters();
      } else {
        closeFilters();
      }
    });

    const hasCheckedGenre = Array.from(genreInputs).some(input => input.checked);
    const hasSortChanged = sortSelect && sortSelect.value !== 'asc';

    if (hasCheckedGenre || hasSortChanged) {
      openFilters();
    }

    if (allGenresCheckbox) {
      allGenresCheckbox.addEventListener('change', function () {
        if (this.checked) {
          const currentSearch = new URLSearchParams(window.location.search).get('q');
          const targetUrl = currentSearch ? `/?q=${encodeURIComponent(currentSearch)}` : '/';
          window.location.href = targetUrl;
        }
      });
    }
  </script>
</body>
</html>